{
  "pluginAlias": "BeautyrestLocal",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "14 local momentary controls per side for compatible Beautyrest bases, including Snore and Massage Timer Cycle. Off is not the physical state. The timer cycles the controller selection; HomeKit does not report its duration.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Plugin name",
        "type": "string",
        "default": "Beautyrest Local"
      },
      "sides": {
        "title": "Bed sides",
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Side name",
              "type": "string",
              "minLength": 1
            },
            "id": {
              "title": "Controller ID",
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{12}$",
              "description": "12 hexadecimal characters from the controller\u2019s mDNS bedinfo.device_id. No IP address or cloud login."
            }
          },
          "required": [
            "name",
            "id"
          ]
        }
      }
    },
    "required": [
      "sides"
    ]
  }
}
